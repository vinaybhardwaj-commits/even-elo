{
  "name": "copilotkit-langgraph-template",
  "private": true,
  "scripts": {
    "dev": "concurrently \"turbo run dev\" \"pnpm run dev:agent\" --names turbo,agent --kill-others",
    "dev:app": "turbo run dev --filter='@repo/app'",
    "dev:agent": "cd apps/agent && uv sync && uv run uvicorn main:app --host 0.0.0.0 --port 8123 --reload",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "test:agent": "uv run --directory apps/agent pytest"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "turbo": "2.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3",
      "@modelcontextprotocol/sdk": "1.31.0",
      "hono": "4.12.25",
      "@hono/node-server": "1.19.10",
      "lodash-es": "4.18.0",
      "langsmith": "0.6.0",
      "form-data": "4.0.6",
      "ws": "8.21.0",
      "fast-uri": "3.1.7",
      "@fastify/busboy": "3.2.1",
      "@a2ui/web_core": "0.10.2",
      "proxy-addr": "2.0.8",
      "@graphql-tools/utils": "12.0.1",
      "express@4>path-to-regexp": "0.1.13",
      "browserslist": "4.28.7",
      "source-map-js": "1.2.2",
      "router>path-to-regexp": "8.4.0",
      "@segment/analytics-node": "link:./stubs/segment-analytics-node"
    },
    "patchedDependencies": {
      "@copilotkit/shared@1.55.2-next.1": "patches/@copilotkit__shared@1.55.2-next.1.patch",
      "@copilotkit/react-core@1.55.2-next.1": "patches/@copilotkit__react-core@1.55.2-next.1.patch",
      "@copilotkit/runtime@1.55.2-next.1": "patches/@copilotkit__runtime@1.55.2-next.1.patch"
    }
  }
}
