# Agent settings: place these in apps/agent/.env. Secrets stay out of git.

# Bedrock (primary). Even reaches Bedrock through GCP federation:
# SA key -> impersonate the SA -> ID token (audience GCP_AUDIENCE, else SA email)
# -> STS AssumeRoleWithWebIdentity on AWS_ROLE_ARN (1 h session, renewed 5 min early).
# BEDROCK_AUTH: gcp-federation (default) or default-chain (standard AWS env chain).
BEDROCK_AUTH=
# Service account key: raw JSON or base64 in GCP_SA_KEY_JSON, or a path in GCP_SA_KEY_FILE.
# Keep real values out of git.
GCP_SA_KEY_JSON=
GCP_SA_KEY_FILE=
GCP_AUDIENCE=
AWS_ROLE_ARN=
BEDROCK_REGION=ap-south-1
# Full model ids only, no aliases. Claude 5.x rejects temperature/top_p/top_k: the agent never sends them.
BEDROCK_MODEL_SONNET=global.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_HAIKU=global.anthropic.claude-haiku-5-5

# Vertex Gemini (fallback only, used when a Bedrock call errors). Empty VERTEX_MODEL disables it.
VERTEX_LOCATION=asia-northeast1
VERTEX_MODEL=

# Jev selects the renderer and visualization before each new user turn.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Frontend settings: place these in apps/app/.env.local (see the Studio zone block below).

# Third-party reporting is forced off in code; these keep it off for any tooling too.
COPILOTKIT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
SCARF_ANALYTICS=false
LANGSMITH_TRACING=false

# ---- Studio zone (M0-S2). Real values live in the host environment, never in git. ----
# Staff session JWT, verified by the app only (same STAFF_JWT_SECRET as even-elo).
# Staff session (G2): epi_session is signed with STAFF_JWT_SECRET (HS256, aud "staff"). Required on the even-studio Vercel project.
STAFF_JWT_SECRET=
# Rollback window only: while JWT_LEGACY_ACCEPT_UNTIL (ISO time) is in the future, a pre-G2 token (JWT_SECRET, no aud,
# old staff shape) is also accepted. Unset or past = legacy rejected. Remove both once the window closes.
JWT_SECRET=
JWT_LEGACY_ACCEPT_UNTIL=
# SELECT-only Neon role over the governance database. Use ?sslmode=verify-full&sslrootcert=system (Asus agent: the local pgbouncer relay 127.0.0.1:6432 holds verify-full to Neon; the loopback leg uses scram). Used by the app (role re-read) and the agent (tools).
GOV_RO_DATABASE_URL=
# Studio state (checkpoints, studio_audit, studio_nonce). Agent only. Same TLS rule: sslmode=verify-full&sslrootcert=system. Pooled URL; migrate with the direct URL.
STUDIO_DATABASE_URL=
# Shared by app and agent: app sends it, agent compares it (constant time).
STUDIO_SERVICE_TOKEN=
# Signs/verifies the 45 s actor JWT. App signs, agent verifies.
STUDIO_ACTOR_SECRET=
# App: the agent Funnel URL, ending in /agent.
AGENT_URL=
# even-elo root app: where /studio is proxied to (bare origin, e.g. https://host). Unset = no rewrite.
STUDIO_ORIGIN=
# Agent: 0/false/off/no/empty serve synthetic fixtures instead of live reads (read on every call). Unset = live.
STUDIO_LIVE_READS=
# Agent: per-staff requests per minute (default 30). STUDIO_LOG_LEVEL default INFO (ids/hashes/timings only).
STUDIO_RATE_PER_MIN=
STUDIO_LOG_LEVEL=

# ---- Studio HTTP read tools (M1-http): eiris_incidents, eiris_incident_detail, opd_signals. App only (even-studio Vercel project). ----
# These run in the app, not the agent (the agent has no egress to these hosts). Names only; real values live in the host environment.
# e-IRIS incident API base and the cross-app service token (same pair even-elo's /api/safety proxy uses).
INCIDENT_API_BASE=
INCIDENT_API_TOKEN=
# CDMSS governance API (roster-audits). GOV_API_BASE is optional (default https://even-cdmss.vercel.app).
GOV_API_BASE=
GOV_API_KEY=
