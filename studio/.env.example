# Agent settings: place these in apps/agent/.env. Secrets stay out of git.

# Bedrock (primary). Even reaches Bedrock through GCP federation:
# SA key -> impersonate the SA -> ID token (audience GCP_AUDIENCE, else SA email)
# -> STS AssumeRoleWithWebIdentity on AWS_ROLE_ARN (1 h session, renewed 5 min early).
# BEDROCK_AUTH: gcp-federation (default) or default-chain (standard AWS env chain).
BEDROCK_AUTH=
# Service account key: raw JSON or base64 in GCP_SA_KEY_JSON, or a path in GCP_SA_KEY_FILE.
# Keep real values out of git.
GCP_SA_KEY_JSON=
GCP_SA_KEY_FILE=
GCP_AUDIENCE=
AWS_ROLE_ARN=
BEDROCK_REGION=ap-south-1
# Full model ids only, no aliases. Claude 5.x rejects temperature/top_p/top_k: the agent never sends them.
BEDROCK_MODEL_SONNET=global.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_HAIKU=global.anthropic.claude-haiku-5-5

# Vertex Gemini (fallback only, used when a Bedrock call errors). Empty VERTEX_MODEL disables it.
VERTEX_LOCATION=asia-northeast1
VERTEX_MODEL=

# Jev selects the renderer and visualization before each new user turn.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Frontend settings: place these in apps/app/.env.local.
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# Third-party reporting is forced off in code; these keep it off for any tooling too.
COPILOTKIT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
SCARF_ANALYTICS=false
LANGSMITH_TRACING=false

# Rate limiting (per IP) - in-process, disabled by default. TODO(M0-S2): replace.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
