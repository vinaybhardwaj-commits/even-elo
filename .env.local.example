# Even-ELO local environment template.
# Copy to .env.local and fill in real values from your Neon project.
# DO NOT commit .env.local — it's in .gitignore.

# Neon Postgres connection string (HTTP driver compatible).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Sprint 3.1 Vertex (Gemini). Names match Vercel production.
# Non-secret pins below are the ratified contract. Leave the service-account
# email and private key empty locally and on Preview unless those secrets
# are installed — GET /api/admin/vertex/health then returns
# state "not_configured" and does not call Vertex.
# Production location is global (gemini-3.8-flash is not offered in Tokyo).
# Leave FEATURE_VERTEX_SUMMARIES=false in production until QA after Sprint 3.3.
# Do not commit key material.
GOOGLE_VERTEX_PROJECT=clinical-infra
GOOGLE_VERTEX_LOCATION=global
GOOGLE_VERTEX_MODEL=gemini-3.8-flash
FEATURE_VERTEX_SUMMARIES=false
VERTEX_CLIENT_EMAIL=
VERTEX_PRIVATE_KEY=

# Stage 1 OT sheet capture. Off unless exactly "true". Do not enable in production
# until a separate go-ahead. Images go to a private Vercel Blob store.
FEATURE_OT_CAPTURE=false
# Stage 2 Vertex classify + extract. Off unless exactly "true".
# Do not enable on Production in this stage. Preview smoke sets both capture flags true.
FEATURE_OT_CAPTURE_OCR=false
BLOB_READ_WRITE_TOKEN=
# Optional. When empty, IP hashes use JWT_SECRET so the raw address is not stored.
CAPTURE_IP_HASH_SALT=
